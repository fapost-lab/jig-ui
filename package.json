{
  "name": "@fapost/jig-ui",
  "version": "0.1.0",
  "description": "A local web interface for Jig, the agent SDLC framework.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "jig-ui": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fapost-lab/jig-ui.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/cli.js",
    "dev": "npm run build && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/cli.js)",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
