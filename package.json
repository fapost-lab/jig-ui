{
  "name": "@fapost/jig-ui",
  "version": "0.5.0",
  "description": "A local web interface for Jig, the agent SDLC framework.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "jig-ui": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fapost-lab/jig-ui.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "npm run build && node dist/cli.js",
    "dev": "npm run build && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & vite build --watch & node --watch dist/cli.js --no-open)",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint . && prettier --check \"server/**/*.ts\" \"web/**/*.{ts,vue,css}\" \"*.{ts,js}\"",
    "format": "eslint --fix . && prettier --write \"server/**/*.ts\" \"web/**/*.{ts,vue,css}\" \"*.{ts,js}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/vue": "^1.59.0",
    "@mdx-js/mdx": "^3.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dompurify": "^3.4.17",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "marked": "^18.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  }
}
